# RNF-06 — credenciais e dados pessoais nunca versionados
.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Pasta de saida (RNF-06): certificado emitido e dado pessoal
saida/
certificados/
*.pdf
*.json
!docs/legado/referencia/*.pdf
!docs/schema/*.json
!docs/postman/*.json
!.claude/settings.json

# Legado (70 MB de .dfm) — fica no compartilhamento, nao no historico
Delphi/

# Editor
.vscode/
*.swp

# backups de editor do .env (credenciais)
.env.*
!.env.example

# log da API (scripts/iniciar_api.ps1)
logs/

# chaves de acesso baixadas do IAM (SEC-01): guardar fora do projeto
*accessKeys*.csv
