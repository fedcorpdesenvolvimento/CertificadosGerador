# Copie para .env e preencha. O .env NAO vai para o Git (RNF-06).
#
# Modelo de conexao copiado de U:\--2021\04-EnvioPorto (03/09/2026), alinhado
# ao FedHub-Backend: as variaveis Firebird tem os MESMOS nomes (FB_*), entao o
# .env do EnvioPorto serve aqui tal como esta (as SFTP_* sao ignoradas).

# --- Firebird 2.5 (FATURA.GDB) — fase 1 -------------------------------------
FB_HOST=192.168.0.6
FB_PORT=3050
FB_DATABASE=E:\SISTEMA\BASE_CHEQUE\BASE\FATURA.GDB
FB_USER=
FB_PASSWORD=
# O certificado imprime acentos; WIN1252 como nos modulos Porto do EnvioPorto.
FB_CHARSET=WIN1252
# Maximo de conexoes ociosas retidas no pool (padrao FedHub: 5)
FB_POOL_SIZE=5

# RNF-05 — este usuario precisa de SELECT em tudo e UPDATE apenas em
# segurados_inc.link_certificado_aws, .dt_cria_link e
# .id_controle_envio_portal. Nada mais.

# --- Selecao do adaptador (ADR-01) -----------------------------------------
# firebird | api
CERTGEN_REPOSITORIO=firebird

# --- Fase 5, adaptador de API ----------------------------------------------
CERTGEN_API_BASE_URL=
CERTGEN_API_TOKEN=

# --- Saida ------------------------------------------------------------------
CERTGEN_PASTA_SAIDA=C:\certificados

# RN-22 — apolices consideradas quando nenhuma e escolhida no fluxo em massa.
# No legado era literal na linha 711 do .pas.
CERTGEN_APOLICES_MASSA=4008,5008,10008,13008,14008,15008

# --- Fase 7, publicacao -----------------------------------------------------
# SEC-01 — o legado tinha AccountKey e AccountName da AWS comentados no
# fonte. Rotacionar essas chaves. Credencial so entra por aqui ou por IAM
# role, nunca no codigo.
AWS_REGION=us-east-2
AWS_S3_BUCKET=certincendioaws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# DEF-21 — no legado era a constante 'albertocordeiro@gmail.com' na linha 430.
CERTGEN_EMAIL_DESTINO=
CERTGEN_SMTP_HOST=
CERTGEN_SMTP_PORT=587
CERTGEN_SMTP_USER=
CERTGEN_SMTP_PASSWORD=
